# =========================================================================
# FIT HEALTH BACKEND CONFIGURATION TEMPLATE
# =========================================================================

# Server Networking
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# Security & JWT Token Signing
JWT_SECRET=super_secret_fithealth_jwt_production_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# OTP Cryptographic Security Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Set to false in production. When true, returns verificationCode in development for headless testing.
EXPOSE_DEV_OTP=true

# =========================================================================
# SMTP Email Provider Options
# =========================================================================

# --- OPTION A: Google Gmail SMTP (Recommended for Personal/Testing) ---
# NOTE: Gmail requires 2-Step Verification enabled and a 16-character "App Password".
# Generate at: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Fit Health Security" <no-reply@fithealth.io>

# --- OPTION B: Brevo (Formerly Sendinblue) SMTP Relay (Production Recommended) ---
# Sign up free at https://www.brevo.com -> Transactional -> SMTP & API
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_master_key
# SMTP_FROM="Fit Health Admin" <verified_sender@yourdomain.com>

# Firebase Cloud Firestore Credentials (Optional - Local JSON Storage Engine is fallback active)
ENABLE_FIREBASE=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...your-private-key...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=

# Legacy MongoDB (Optional)
ENABLE_MONGODB=false
MONGODB_URI=mongodb://127.0.0.1:27017/fit_health_db

# Evaluator & Demo Accounts
DEMO_USER_EMAIL=alex@fithealth.io
DEMO_USER_PASSWORD=password123
DEMO_ADMIN_EMAIL=admin@fithealth.io
DEMO_ADMIN_PASSWORD=admin123
