# =========================================================================
# FIT HEALTH - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Application & Ingress URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & JWT Authentication
JWT_SECRET=generate_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# SMTP Email Service & OTP Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_verified_sender@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Fit Health Security" <your_verified_sender@gmail.com>
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Firebase Cloud Firestore (Exclusive Application Database)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=

# Biometrics AES-256-GCM Hardware-Grade Encryption At Rest (64 hex characters / 32 bytes)
BIOMETRICS_ENCRYPTION_KEY=generate_64_hex_chars_using_crypto_randomBytes_32
BIOMETRICS_RATE_LIMIT_PER_MINUTE=60

# Health Provider Cloud OAuth 2.0 Credentials
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:5000/api/health/callback/fitbit

GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:5000/api/health/callback/garmin

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:5000/api/health/callback/withings

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5000/api/health/callback/oura

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5000/api/health/callback/whoop

POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:5000/api/health/callback/polar
